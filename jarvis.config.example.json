{
  "$schema": "./docs/config.schema.json",
  "owner_name": "Alex",
  "projects_root": "~/Projects",
  "timezone": "America/New_York",
  "site_url": "https://your-jarvis.vercel.app",

  "projects": {
    "include": [],
    "exclude": ["node_modules", ".jarvis-worktrees", "archive"],
    "overrides": {
      "example-project": { "name": "Example", "kind": "checklist", "color": "p1", "tagline": "One line on what it is." }
    }
  },

  "planner": {
    "run": { "weekday": "sunday", "time": "17:00" },
    "work_days": ["Mon", "Tue", "Wed", "Thu", "Fri"],
    "hours": [["09:00", "12:30"], ["13:30", "18:00"]],
    "max_focus_minutes_per_day": 360,
    "buffer_minutes": 15,
    "weekends": "overflow",
    "project_caps": { "example-project": 360 },
    "adapt": "suggest",
    "adapt_min_todos": 3
  },

  "reviews": {
    "run": { "weekday": "monday", "time": "05:00" },
    "advisors": ["ceo", "cmo", "po"],
    "stance": "Be sceptical by default. Challenge optimistic plans with evidence; validate only what the evidence supports.",
    "concurrency": 2,
    "repo_scout": true,
    "repo_scout_skip": []
  },

  "worker": {
    "interval_seconds": 60,
    "allow_build": true,
    "refine_new_items": true,
    "refine_inbox_notes": false,
    "discuss_model": "sonnet",
    "build_model": null,
    "timeout_minutes": 25
  },

  "project_setup": {
    "auto_on_load": true,
    "auto_on_update": true,
    "cooldown_days": 7,
    "check_minutes": 60,
    "model": null
  },

  "audits": {
    "dir": "docs/audits",
    "sync_minutes": 60
  },

  "economics": {
    "files": ["jarvis.economics.mjs", "jarvis.economics.cjs", "jarvis.economics.js"],
    "models": { "example-project": "docs/finance/jarvis.economics.cjs" },
    "sync_minutes": 60,
    "timeout_seconds": 30
  },

  "metrics": {
    "sync_minutes": 1440,
    "timeout_seconds": 30,
    "sources": {
      "example-project": { "url": "https://example.com/api/metrics", "token_env": "EXAMPLE_METRICS_TOKEN" },
      "other-project": { "command": "node scripts/metrics.mjs", "map": { "visits": "traffic.visitors", "users": "accounts.total" } }
    }
  },

  "guard": {
    "deny": []
  },

  "usage": {
    "track_clicks": true,
    "retention_days": 90
  },

  "calendars": {
    "read_google": true,
    "read_apple": false,
    "write_google": true,
    "write_apple_feed": false
  }
}
